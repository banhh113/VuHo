@model CLBVo.Models.ClubLocation
@{
    ViewData["Title"] = "Thêm cơ sở";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>+ Thêm cơ sở</h1>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Create" method="post" class="admin-form" autocomplete="off">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tên cơ sở *</label>
        <input asp-for="Name" required maxlength="200" autocomplete="off"
               placeholder="VD: Cơ sở 1 - Tam Phước" />
    </div>

    <div class="form-group">
        <label>Địa chỉ *</label>
        <textarea asp-for="Address" rows="3" required autocomplete="off"
                  placeholder="VD: Ngã 3 Thái Lan, KP. Long Đức, Phường Tam Phước, TP. Biên Hòa, Đồng Nai"></textarea>
    </div>

    <div class="form-group">
        <label>Link Google Maps</label>
        <input asp-for="MapUrl" type="text" maxlength="500" autocomplete="nope"
               placeholder="Dán link Google Maps vào đây" />
        <small>Vào Google Maps → tìm địa chỉ → Chia sẻ → Sao chép liên kết → dán vào đây.</small>
    </div>

    <div class="form-group">
        <label>Thứ tự hiển thị</label>
        <input asp-for="SortOrder" type="number" min="0" value="0" autocomplete="off" />
        <small>Số nhỏ hiển thị trước. VD: 1, 2, 3...</small>
    </div>

    <div class="form-group">
        <label class="checkbox-label">
            <input asp-for="IsActive" type="checkbox" checked />
            Hiển thị trên trang chủ
        </label>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Lưu cơ sở</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>