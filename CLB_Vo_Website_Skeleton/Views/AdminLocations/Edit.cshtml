@model CLBVo.Models.ClubLocation
@{
    ViewData["Title"] = "Sửa cơ sở";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>✏️ Sửa cơ sở</h1>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tên cơ sở *</label>
        <input asp-for="Name" required maxlength="200" autocomplete="off" />
    </div>

    <div class="form-group">
        <label>Địa chỉ *</label>
        <textarea asp-for="Address" rows="3" required autocomplete="off"></textarea>
    </div>

    <div class="form-group">
        <label>Link Google Maps</label>
        <input asp-for="MapUrl" type="text" maxlength="500" autocomplete="nope" />
        <small>Vào Google Maps → tìm địa chỉ → Chia sẻ → Sao chép liên kết → dán vào đây.</small>
    </div>

    <div class="form-group">
        <label>Thứ tự hiển thị</label>
        <input asp-for="SortOrder" type="number" min="0" autocomplete="off" />
    </div>

    <div class="form-group">
        <label class="checkbox-label">
            <input asp-for="IsActive" type="checkbox" />
            Hiển thị trên trang chủ
        </label>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>