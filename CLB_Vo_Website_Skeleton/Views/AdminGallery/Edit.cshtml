@model CLBVo.Models.GalleryImage
@{
    ViewData["Title"] = "Sửa ảnh";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>✏️ Sửa ảnh</h1>
        <p class="admin-subtitle">@Model.Title</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post"
      enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tiêu đề *</label>
        <input asp-for="Title" required maxlength="255" />
    </div>

    <div class="form-group">
        <label>Ngày đăng *</label>
        <input asp-for="CreatedAt" type="datetime-local" required
               value="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm")" />
        <small>Có thể sửa để đổi ngày hiển thị ảnh.</small>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="form-group">
            <label>Ảnh hiện tại</label>
            <img src="@Model.ImageUrl" alt="@Model.Title"
                 style="max-width:320px;border-radius:10px;
                        border:2px solid rgba(255,255,255,0.1)" />
        </div>
    }

    <div class="form-group">
        <label>Thay ảnh mới (để trống nếu giữ ảnh cũ)</label>
        <input type="file" name="imageFile" accept="image/*" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>