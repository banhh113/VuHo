@{
    ViewData["Title"] = "Thêm ảnh vào thư viện";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>+ Thêm ảnh vào thư viện</h1>
        <p class="admin-subtitle">Chọn nhiều ảnh để upload cùng lúc</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tiêu đề chung *</label>
        <input type="text" name="title" required maxlength="255"
               placeholder="VD: Giải đấu võ thuật 2026" />
        <small>Tất cả ảnh upload cùng lúc sẽ dùng chung tiêu đề này.</small>
    </div>

    <div class="form-group">
        <label>Chọn ảnh *</label>
        <input type="file" name="imageFiles" accept="image/*" multiple required />
        <small>
            Giữ <kbd>Ctrl</kbd> (Windows) hoặc <kbd>Cmd</kbd> (Mac) để chọn nhiều ảnh cùng lúc.
            <br />Chấp nhận jpg, png, gif, webp. Mỗi ảnh tối đa 5MB.
        </small>
    </div>

    <div class="form-group">
        <label>Xem trước ảnh đã chọn</label>
        <div id="preview" class="preview-grid"></div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Upload ảnh</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <script>
        const input = document.querySelector('input[type="file"]');
        const preview = document.getElementById('preview');
        input.addEventListener('change', () => {
            preview.innerHTML = '';
            [...input.files].forEach(f => {
                const reader = new FileReader();
                reader.onload = e => {
                    const div = document.createElement('div');
                    div.className = 'preview-item';
                    div.innerHTML = `<img src="${e.target.result}" alt="preview" />`;
                    preview.appendChild(div);
                };
                reader.readAsDataURL(f);
            });
        });
    </script>
}