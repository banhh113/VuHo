@model CLBVo.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<!-- WELCOME BANNER -->
<div class="welcome-banner">
    <div class="welcome-text">
        <h1>
            <svg class="ico ico-lg welcome-wave" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 11.5V14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-2.5"/>
                <path d="M18 8.5c0-3.5-2.5-6-6-6s-6 2.5-6 6"/>
                <line x1="12" y1="2" x2="12" y2="4"/>
            </svg>
            Xin chào, @Model.AdminName!
        </h1>
        <p>@Model.CurrentDate • Chúc bạn một ngày làm việc hiệu quả</p>
    </div>
    <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline">
        <svg class="ico ico-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        Xem trang chủ
    </a>
</div>

<!-- STATS CARDS -->
<div class="stats-grid">
    <div class="stat-card stat-card-blue">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
        </div>
        <div class="stat-info">
            <strong data-count="@Model.PostCount">0</strong>
            <span>Bài viết</span>
        </div>
    </div>

    <div class="stat-card stat-card-green">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <div class="stat-info">
            <strong data-count="@Model.MemberCount">0</strong>
            <span>Thành viên</span>
        </div>
    </div>

    <div class="stat-card stat-card-red">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
        </div>
        <div class="stat-info">
            <strong data-count="@Model.EventCount">0</strong>
            <span>Sự kiện</span>
        </div>
    </div>

    <div class="stat-card stat-card-purple">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
            </svg>
        </div>
        <div class="stat-info">
            <strong data-count="@Model.GalleryCount">0</strong>
            <span>Ảnh thư viện</span>
        </div>
    </div>

    <div class="stat-card stat-card-gold">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                <path d="M4 22h16"/>
                <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
            </svg>
        </div>
        <div class="stat-info">
            <strong data-count="@Model.AchievementCount">0</strong>
            <span>Thành tích</span>
        </div>
    </div>

    <a asp-controller="AdminRegistrations" asp-action="Index" class="stat-card stat-card-blue">
        <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
                <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
            </svg>
        </div>
        <div class="stat-info">
            <strong data-count="@Model.NewRegistrationCount">0</strong>
            <span>Đăng ký mới</span>
        </div>
    </a>
</div>

<!-- QUICK ACTIONS -->
<div class="quick-actions">
    <h3>
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        Thao tác nhanh
    </h3>
    <div class="quick-actions-grid">
        <a asp-controller="AdminPosts" asp-action="Create" class="quick-action">
            <div class="quick-action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
            </div>
            <div>
                <strong>Thêm bài viết</strong>
                <small>Đăng tin tức mới</small>
            </div>
        </a>

        <a asp-controller="AdminMembers" asp-action="Create" class="quick-action">
            <div class="quick-action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="8.5" cy="7" r="4"/>
                    <line x1="20" y1="8" x2="20" y2="14"/>
                    <line x1="23" y1="11" x2="17" y2="11"/>
                </svg>
            </div>
            <div>
                <strong>Thêm thành viên</strong>
                <small>Bổ sung HLV / võ sinh</small>
            </div>
        </a>

        <a asp-controller="AdminEvents" asp-action="Create" class="quick-action">
            <div class="quick-action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                    <line x1="12" y1="14" x2="12" y2="18"/>
                    <line x1="10" y1="16" x2="14" y2="16"/>
                </svg>
            </div>
            <div>
                <strong>Thêm sự kiện</strong>
                <small>Tạo giải đấu / buổi tập</small>
            </div>
        </a>

        <a asp-controller="AdminGallery" asp-action="Create" class="quick-action">
            <div class="quick-action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                </svg>
            </div>
            <div>
                <strong>Upload ảnh</strong>
                <small>Bổ sung thư viện</small>
            </div>
        </a>
    </div>
</div>

<!-- 2 COLUMN: CHART + RECENT POSTS -->
<div class="admin-two-col">
    <div class="admin-panel">
        <div class="panel-header">
            <h2>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/>
                    <line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                Bài viết 6 tháng gần đây
            </h2>
        </div>
        <canvas id="postsChart" style="max-height:280px"></canvas>
    </div>

    <div class="admin-panel">
        <div class="panel-header">
            <h2>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
                Bài viết gần đây
            </h2>
            <a asp-controller="AdminPosts" asp-action="Index">Xem tất cả →</a>
        </div>

        @if (Model.RecentPosts.Any())
        {
            <ul class="panel-list">
                @foreach (var p in Model.RecentPosts)
                {
                    <li>
                        <div style="flex:1;min-width:0">
                            <div class="list-title">@p.Title</div>
                            <div class="list-meta">@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <a asp-controller="AdminPosts" asp-action="Edit"
                           asp-route-id="@p.Id" class="list-action">Sửa</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-state">Chưa có bài viết nào.</p>
        }
    </div>
</div>

<!-- 2 COLUMN: UPCOMING EVENTS + RECENT MEMBERS -->
<div class="admin-two-col">
    <div class="admin-panel">
        <div class="panel-header">
            <h2>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Sự kiện sắp tới
            </h2>
            <a asp-controller="AdminEvents" asp-action="Index">Xem tất cả →</a>
        </div>

        @if (Model.UpcomingEvents.Any())
        {
            <ul class="panel-list">
                @foreach (var e in Model.UpcomingEvents)
                {
                    <li>
                        <div class="event-date-badge">
                            <strong>@e.EventDate.Day</strong>
                            <span>T@(e.EventDate.Month)</span>
                        </div>
                        <div style="flex:1;min-width:0">
                            <div class="list-title">@e.Title</div>
                            <div class="list-meta">@e.Location</div>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-state">Chưa có sự kiện nào sắp diễn ra.</p>
        }
    </div>

    <div class="admin-panel">
        <div class="panel-header">
            <h2>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                Thành viên mới
            </h2>
            <a asp-controller="AdminMembers" asp-action="Index">Xem tất cả →</a>
        </div>

        @if (Model.RecentMembers.Any())
        {
            <ul class="panel-list">
                @foreach (var m in Model.RecentMembers)
                {
                    <li>
                        @if (!string.IsNullOrEmpty(m.AvatarUrl))
                        {
                            <img src="@m.AvatarUrl" alt="@m.FullName"
                                 style="width:40px;height:40px;border-radius:50%;
                                        object-fit:cover;border:2px solid rgba(255,255,255,0.1)" />
                        }
                        else
                        {
                            <div style="width:40px;height:40px;border-radius:50%;
                                        background:linear-gradient(135deg,#c8102e,#f5c518);
                                        display:grid;place-items:center">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     style="width:20px;height:20px;color:#fff">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                        }
                        <div style="flex:1;min-width:0">
                            <div class="list-title">@m.FullName</div>
                            <div class="list-meta">@m.Role</div>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-state">Chưa có thành viên nào.</p>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Counter animation
        document.querySelectorAll('.stat-info strong[data-count]').forEach(el => {
            const target = parseInt(el.dataset.count, 10);
            if (target === 0) { el.textContent = '0'; return; }
            let current = 0;
            const step = Math.max(1, Math.ceil(target / 40));
            const timer = setInterval(() => {
                current += step;
                if (current >= target) {
                    el.textContent = target;
                    clearInterval(timer);
                } else {
                    el.textContent = current;
                }
            }, 25);
        });

        // Chart
        const ctx = document.getElementById('postsChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartMonths)),
                    datasets: [{
                        label: 'Số bài viết',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartPostCounts)),
                        backgroundColor: 'rgba(245, 197, 24, 0.6)',
                        borderColor: '#f5c518',
                        borderWidth: 2,
                        borderRadius: 8,
                        hoverBackgroundColor: '#f5c518'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { color: '#a0a0a0', stepSize: 1, precision: 0 },
                            grid: { color: 'rgba(255,255,255,0.05)' }
                        },
                        x: {
                            ticks: { color: '#a0a0a0' },
                            grid: { display: false }
                        }
                    }
                }
            });
        }
    </script>
}