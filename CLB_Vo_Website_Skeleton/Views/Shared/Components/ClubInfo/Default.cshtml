@model CLBVo.Models.ClubInfo

<!-- Cột Liên hệ (SĐT + Email) -->
<div class="footer-col">
    <h4>📍 Liên hệ</h4>
    <ul class="footer-contact">
        @if (!string.IsNullOrEmpty(Model?.Phone))
        {
            <li>
                <span class="contact-icon">📞</span>
                <span style="white-space: pre-line">@Model.Phone</span>
            </li>
        }
        @if (!string.IsNullOrEmpty(Model?.Email))
        {
            <li>
                <span class="contact-icon">✉️</span>
                <a href="mailto:@Model.Email">@Model.Email</a>
            </li>
        }
        @if (string.IsNullOrEmpty(Model?.Phone) && string.IsNullOrEmpty(Model?.Email))
        {
            <li style="color:#666;font-style:italic">
                Chưa cập nhật thông tin liên hệ
            </li>
        }
    </ul>
</div>

<!-- Cột Địa chỉ -->
<div class="footer-col">
    <h4>📍 Địa chỉ</h4>
    <ul class="footer-contact">
        @if (!string.IsNullOrEmpty(Model?.Address))
        {
            <li>
                <span class="contact-icon">📍</span>
                <span style="white-space: pre-line">@Model.Address</span>
            </li>
        }
        else
        {
            <li style="color:#666;font-style:italic">
                Chưa cập nhật địa chỉ
            </li>
        }
    </ul>
</div>