@model CLBVo.Models.ClubInfo
@using CLBVo.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

@{
    var locations = Db.ClubLocations
        .Where(l => l.IsActive)
        .OrderBy(l => l.SortOrder)
        .ThenBy(l => l.Id)
        .ToList();
}

<!-- Cột Liên hệ -->
<div class="footer-col">
    <h4>📍 Liên hệ</h4>
    <ul class="footer-contact">
        @if (!string.IsNullOrEmpty(Model?.Phone))
        {
            <li>
                <span class="contact-icon">📞</span>
                <span style="white-space: pre-line">@Model.Phone</span>
            </li>
        }
        @if (!string.IsNullOrEmpty(Model?.Email))
        {
            <li>
                <span class="contact-icon">✉️</span>
                <a href="mailto:@Model.Email">@Model.Email</a>
            </li>
        }
    </ul>
</div>

<!-- Cột Địa chỉ + Map links -->
<div class="footer-col">
    <h4>📍 Địa chỉ</h4>
    <ul class="footer-contact">
        @if (locations.Any())
        {
            @foreach (var loc in locations)
            {
                <li style="flex-direction:column;align-items:flex-start;gap:6px">
                    <div style="display:flex;gap:12px;align-items:flex-start">
                        <span class="contact-icon">📍</span>
                        <div>
                            <strong style="color:#f5c518;font-size:.82rem;display:block">@loc.Name</strong>
                            <div style="white-space:pre-line;color:#a0a0a0;font-size:.85rem;margin-top:4px">
                                @loc.Address
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(loc.MapUrl))
                    {
                        <a href="@loc.MapUrl" target="_blank" rel="noopener"
                           class="map-link" style="margin-left:34px">
                            🗺️ Xem trên Google Maps →
                        </a>
                    }
                </li>
            }
        }
        else
        {
            <li style="color:#666;font-style:italic">Chưa cập nhật địa chỉ</li>
        }
    </ul>
</div>