<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin CLB Vũ Hổ</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body class="admin-body">

    <aside class="admin-sidebar">
        <div class="admin-brand">
            <img src="~/images/logo.png" alt="Logo" />
            <div>
                <span>VŨ HỔ</span>
                <small>Admin Panel</small>
            </div>
        </div>

        <nav class="admin-nav">
            <a asp-controller="Admin" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Dashboard">
                <span class="nav-icon">📊</span>
                <span class="nav-label">Dashboard</span>
            </a>

            <a asp-controller="AdminPosts" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Bài viết">
                <span class="nav-icon">📝</span>
                <span class="nav-label">Bài viết</span>
            </a>

            <a href="#" class="admin-nav-item disabled"
               data-tooltip="Sắp có"
               onclick="return false;">
                <span class="nav-icon">👥</span>
                <span class="nav-label">Thành viên</span>
                <span class="nav-badge">sắp có</span>
            </a>

            <a href="#" class="admin-nav-item disabled"
               data-tooltip="Sắp có"
               onclick="return false;">
                <span class="nav-icon">📅</span>
                <span class="nav-label">Sự kiện</span>
                <span class="nav-badge">sắp có</span>
            </a>

            <a href="#" class="admin-nav-item disabled"
               data-tooltip="Sắp có"
               onclick="return false;">
                <span class="nav-icon">🖼️</span>
                <span class="nav-label">Thư viện</span>
                <span class="nav-badge">sắp có</span>
            </a>

            <a href="#" class="admin-nav-item disabled"
               data-tooltip="Sắp có"
               onclick="return false;">
                <span class="nav-icon">🏆</span>
                <span class="nav-label">Thành tích</span>
                <span class="nav-badge">sắp có</span>
            </a>

            <a href="#" class="admin-nav-item disabled"
               data-tooltip="Sắp có"
               onclick="return false;">
                <span class="nav-icon">⚙️</span>
                <span class="nav-label">Thông tin CLB</span>
                <span class="nav-badge">sắp có</span>
            </a>
        </nav>

        <div class="admin-sidebar-footer">
            <div class="admin-user">
                <div class="user-avatar">👤</div>
                <div class="user-info">
                    <strong>@(User.Identity?.Name?.Split('@')[0] ?? "Admin")</strong>
                    <small>Administrator</small>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <span class="logout-icon">🚪</span>
                    <span class="logout-label">Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="admin-main-wrapper">
        <header class="admin-topbar">
            <button class="admin-toggle" onclick="document.querySelector('.admin-sidebar').classList.toggle('open')">☰</button>
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-actions">
                <a asp-controller="Home" asp-action="Index" target="_blank">🌐 Trang chủ</a>
            </div>
        </header>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

</body>
</html>