<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin CLB Vũ Hổ</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body class="admin-body">

    <aside class="admin-sidebar">
        <div class="admin-brand">
            <img src="~/images/logo.png" alt="Logo" />
            <div>
                <span>VŨ HỔ</span>
                <small>Admin Panel</small>
            </div>
        </div>

        <nav class="admin-nav">
            <a asp-controller="Admin" asp-action="Index" class="admin-nav-item" data-tooltip="Dashboard">
                <span class="nav-icon"><i data-lucide="layout-dashboard"></i></span>
                <span class="nav-label">Dashboard</span>
            </a>

            <a asp-controller="AdminRegistrations" asp-action="Index" class="admin-nav-item" data-tooltip="Đăng ký tập">
                <span class="nav-icon"><i data-lucide="inbox"></i></span>
                <span class="nav-label">Đăng ký tập thử</span>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <!-- NHÓM 1: NỘI DUNG -->
                <details class="admin-nav-group">
                    <summary class="admin-nav-item">
                        <span class="nav-icon"><i data-lucide="file-text"></i></span>
                        <span class="nav-label">Quản lý Nội dung</span>
                    </summary>
                    <div class="admin-nav-sub">
                        <a asp-controller="AdminPosts" asp-action="Index" class="admin-nav-item">Bài viết</a>
                        <a asp-controller="AdminEvents" asp-action="Index" class="admin-nav-item">Sự kiện</a>
                        <a asp-controller="AdminGallery" asp-action="Index" class="admin-nav-item">Thư viện ảnh</a>
                        <a asp-controller="AdminSocialLinks" asp-action="Index" class="admin-nav-item">Mạng xã hội</a>
                    </div>
                </details>

                <!-- NHÓM 2: ĐÀO TẠO & CLB -->
                <details class="admin-nav-group">
                    <summary class="admin-nav-item">
                        <span class="nav-icon"><i data-lucide="users"></i></span>
                        <span class="nav-label">Đào tạo & CLB</span>
                    </summary>
                    <div class="admin-nav-sub">
                        <a asp-controller="AdminMembers" asp-action="Index" class="admin-nav-item">Thành viên (HLV/VĐV)</a>
                        <a asp-controller="AdminTournaments" asp-action="Index" class="admin-nav-item">Giải đấu</a>
                        <a asp-controller="AdminTimeSlots" asp-action="Index" class="admin-nav-item">Khung giờ tập</a>
                        <a asp-controller="AdminLocations" asp-action="Index" class="admin-nav-item">Cơ sở</a>
                    </div>
                </details>

                <!-- NHÓM 3: HỆ THỐNG -->
                <details class="admin-nav-group">
                    <summary class="admin-nav-item">
                        <span class="nav-icon"><i data-lucide="settings"></i></span>
                        <span class="nav-label">Hệ thống & Cài đặt</span>
                    </summary>
                    <div class="admin-nav-sub">
                        <a asp-controller="AdminUsers" asp-action="Index" class="admin-nav-item">Quản lý Tài khoản</a>
                        <a asp-controller="AdminClubInfo" asp-action="Index" class="admin-nav-item">Thông tin CLB</a>
                    </div>
                </details>
            }
        </nav>

        <div class="admin-sidebar-footer">
            <div class="admin-user">
                <div class="user-avatar">
                    <i data-lucide="user"></i>
                </div>
                <div class="user-info">
                    <strong>@(User.Identity?.Name?.Split('@')[0] ?? "User")</strong>
                    <small>@(User.IsInRole("Admin") ? "Quản trị viên" : (User.IsInRole("Staff") ? "Nhân viên" : "Thành viên"))</small>
                </div>
            </div>

            <a asp-controller="Account" asp-action="ChangePassword" class="btn-logout" style="text-decoration:none;justify-content:center;margin-bottom:10px">
                <span class="logout-icon"><i data-lucide="key"></i></span>
                <span class="logout-label">Đổi mật khẩu</span>
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <span class="logout-icon"><i data-lucide="log-out"></i></span>
                    <span class="logout-label">Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="admin-main-wrapper">
        <header class="admin-topbar">
            <button class="admin-toggle" onclick="document.querySelector('.admin-sidebar').classList.toggle('open')">
                <i data-lucide="menu" style="width:20px;height:20px;"></i>
            </button>
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-actions">
                <a asp-controller="Home" asp-action="Index" target="_blank">
                    <i data-lucide="external-link" style="width:14px;height:14px;vertical-align:-2px;"></i> Trang chủ
                </a>
            </div>
        </header>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>