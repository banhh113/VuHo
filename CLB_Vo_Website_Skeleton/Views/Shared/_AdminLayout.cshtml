<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin CLB Vũ Hổ</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body class="admin-body">

    <aside class="admin-sidebar">
        <div class="admin-brand">
            <img src="~/images/logo.png" alt="Logo" />
            <div>
                <span>VŨ HỔ</span>
                <small>Admin Panel</small>
            </div>
        </div>

        <nav class="admin-nav">
            <a asp-controller="Admin" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Dashboard">
                <span class="nav-icon">📊</span>
                <span class="nav-label">Dashboard</span>
            </a>

            <a asp-controller="AdminPosts" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Bài viết">
                <span class="nav-icon">📝</span>
                <span class="nav-label">Bài viết</span>
            </a>

            <a asp-controller="AdminMembers" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Thành viên">
                <span class="nav-icon">👥</span>
                <span class="nav-label">Thành viên</span>
            </a>

            <a asp-controller="AdminEvents" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Sự kiện">
                <span class="nav-icon">📅</span>
                <span class="nav-label">Sự kiện</span>
            </a>

            <a asp-controller="AdminGallery" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Thư viện">
                <span class="nav-icon">🖼️</span>
                <span class="nav-label">Thư viện</span>
            </a>

            <a asp-controller="AdminAchievements" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Thành tích">
                <span class="nav-icon">🏆</span>
                <span class="nav-label">Thành tích</span>
            </a>

            <a asp-controller="AdminClubInfo" asp-action="Index"
               class="admin-nav-item"
               data-tooltip="Thông tin CLB">
                <span class="nav-icon">⚙️</span>
                <span class="nav-label">Thông tin CLB</span>
            </a>
        </nav>

        <div class="admin-sidebar-footer">
    <div class="admin-user">
        <div class="user-avatar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
        </div>
        <div class="user-info">
            <strong>@(User.Identity?.Name?.Split('@')[0] ?? "Admin")</strong>
            <small>Administrator</small>
        </div>
    </div>

    <!-- Đổi mật khẩu -->
    <a asp-controller="Account" asp-action="ChangePassword"
       class="btn-logout"
       style="text-decoration:none;margin-bottom:10px">
        <span class="logout-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </span>
        <span class="logout-label">Đổi mật khẩu</span>
    </a>

    <!-- Đăng xuất -->
    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-logout">
            <span class="logout-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </span>
            <span class="logout-label">Đăng xuất</span>
        </button>
    </form>
</div>
    </aside>

    <div class="admin-main-wrapper">
        <header class="admin-topbar">
            <button class="admin-toggle" onclick="document.querySelector('.admin-sidebar').classList.toggle('open')">☰</button>
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-actions">
                <a asp-controller="Home" asp-action="Index" target="_blank">🌐 Trang chủ</a>
            </div>
        </header>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>