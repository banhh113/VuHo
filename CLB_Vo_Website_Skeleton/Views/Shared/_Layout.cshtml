<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CLB Vũ Hổ</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body>
    <header class="site-header">
        <div class="container nav-wrapper">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="CLB Vũ Hổ" class="logo-img" />
                <span>CLB VŨ HỔ</span>
            </a>

            <nav>
                <a href="/#about">Giới thiệu</a>
                <a href="/#news">Tin tức</a>
                <a href="/#events">Thông báo & Lịch tập</a>
                <a href="/#members">Thành viên</a>
                <a href="/#gallery">Thư viện</a>
                <a href="/#contact">Liên hệ</a>
                <a href="/dang-ky" style="color:#f5c518">📩 Đăng ký tập</a>
            </nav>

            <a class="admin-link" asp-controller="Admin" asp-action="Index">🔐 Admin</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer id="contact" class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h3>
                        <img src="~/images/logo.png" alt="Logo" class="footer-logo" />
                        CLB Vũ Hổ
                    </h3>
                    <p>Rèn luyện • Kỷ luật • Bản lĩnh</p>
                    <p class="footer-tagline">
                        Nơi hun đúc tinh thần võ thuật cho thế hệ trẻ
                    </p>
                </div>

                @await Component.InvokeAsync("ClubInfo")
            </div>

            <div class="footer-bottom">
                <p>© @DateTime.Now.Year CLB Vũ Hổ. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>