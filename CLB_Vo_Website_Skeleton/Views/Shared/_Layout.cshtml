@using CLBVo.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    var socialLinks = Db.SocialLinks
        .Where(s => s.IsActive)
        .OrderBy(s => s.SortOrder)
        .ThenBy(s => s.Id)
        .ToList();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CLB Vũ Hổ</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Bungee&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body>

    <header class="site-header" id="siteHeader">
        <div class="container nav-wrapper">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="CLB Vũ Hổ" class="brand-logo" />
                <div class="brand-text">
                    <strong>CLB VŨ HỔ</strong>
                    <small>Rèn thân - Luyện chí - Cùng nhau tiến bước</small>
                </div>
            </a>

            <nav class="main-nav" id="mainNav">
                <a href="/" class="nav-link">Trang chủ</a>
                <a href="/#about" class="nav-link">Giới thiệu</a>
                <a href="/#schedule" class="nav-link">Lịch tập</a>
                <a href="/#coaches" class="nav-link">Đội ngũ HLV</a>
                <a href="/#news" class="nav-link">Tin tức</a>
                <a href="/thanh-tich" class="nav-link">Thành tích</a>
                <a href="/#contact" class="nav-link">Liên hệ</a>
            </nav>

            <div class="header-actions">
                <a class="btn-cta" asp-controller="Registration" asp-action="Index">
                    <svg class="ico ico-sm" viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span>Đăng ký tập thử</span>
                </a>

                <button class="menu-toggle" id="menuToggle" aria-label="Mở menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="mobile-menu" id="mobileMenu">
            <nav>
                <a href="/">Trang chủ</a>
                <a href="/#about">Giới thiệu</a>
                <a href="/#schedule">Lịch tập</a>
                <a href="/#coaches">Đội ngũ HLV</a>
                <a href="/#news">Tin tức</a>
                <a href="/thanh-tich">Thành tích</a>
                <a href="/#contact">Liên hệ</a>
                <a asp-controller="Registration" asp-action="Index" class="mobile-cta">
                    <svg class="ico ico-sm" viewBox="0 0 24 24">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                    <span>Đăng ký tập thử</span>
                </a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-top">
            <a class="footer-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="CLB Vũ Hổ" />
                <div>
                    <strong>CLB VŨ HỔ</strong>
                    <small>Rèn thân - Luyện chí - Cùng nhau tiến bước</small>
                </div>
            </a>

            <nav class="footer-nav">
                <a href="/">Trang chủ</a>
                <a href="/#about">Giới thiệu</a>
                <a href="/#schedule">Lịch tập</a>
                <a href="/#coaches">Đội ngũ HLV</a>
                <a href="/#news">Tin tức</a>
                <a href="/thanh-tich">Thành tích</a>
                <a href="/#contact">Liên hệ</a>
            </nav>

            @* ⭐ Đã bỏ footer-social — social icons chuyển thành floating *@
        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>© @DateTime.Now.Year CLB Vũ Hổ. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <nav class="bottom-tab">
        <a href="/" class="bottom-tab-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>Trang chủ</span>
        </a>
        <a href="/#schedule" class="bottom-tab-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Lịch tập</span>
        </a>
        <a href="/#news" class="bottom-tab-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><line x1="18" y1="14" x2="12" y2="14"/><line x1="18" y1="18" x2="12" y2="18"/><line x1="18" y1="10" x2="12" y2="10"/></svg>
            <span>Tin tức</span>
        </a>
        <a href="/#contact" class="bottom-tab-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Liên hệ</span>
        </a>
    </nav>

    <!-- ⭐ FLOATING SOCIAL ICONS — góc phải dưới, ngay trên scroll-top -->
    @if (socialLinks.Any())
    {
        <div class="floating-social">
            @foreach (var social in socialLinks)
            {
                var title = social.DisplayName ?? social.Platform;
                <a href="@social.Url" target="_blank" rel="noopener"
                   class="floating-social-link floating-social-@social.Platform"
                   aria-label="@title" title="@title">
                    @switch (social.Platform)
                    {
                        case "facebook":
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            break;

                        case "zalo":
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 5.82 2 10.55c0 2.7 1.46 5.11 3.75 6.72V22l3.4-1.87c.9.24 1.86.37 2.85.37 5.52 0 10-3.82 10-8.55S17.52 2 12 2zM8.22 13.85h-1.9c-.28 0-.5-.22-.5-.5v-3.5c0-.28.22-.5.5-.5h1.9c.28 0 .5.22.5.5v3.5c0 .28-.22.5-.5.5zm4.52 0h-.28c-.28 0-.5-.22-.5-.5v-2.6l-1.55 2.8c-.1.17-.28.28-.48.28h-.14c-.28 0-.5-.22-.5-.5v-3.5c0-.28.22-.5.5-.5h.28c.28 0 .5.22.5.5v2.6l1.55-2.8c.1-.17.28-.28.48-.28h.14c.28 0 .5.22.5.5v3.5c0 .28-.22.5-.5.5zm3.46 0h-2.1c-.28 0-.5-.22-.5-.5v-3.5c0-.28.22-.5.5-.5h2.1c.28 0 .5.22.5.5v.5c0 .28-.22.5-.5.5h-1.6v.5h1.6c.28 0 .5.22.5.5v.5c0 .28-.22.5-.5.5h-1.6v.5h1.6c.28 0 .5.22.5.5v.5c0 .28-.22.5-.5.5z"/>
                            </svg>
                            break;

                        case "youtube":
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                            break;

                        case "tiktok":
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.65a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.08z"/></svg>
                            break;

                        case "instagram":
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1 1 12.324 0 6.162 6.162 0 0 1-12.324 0zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm4.965-10.322a1.44 1.44 0 1 1 2.881.001 1.44 1.44 0 0 1-2.881-.001z"/></svg>
                            break;

                        default:
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="2" y1="12" x2="22" y2="12"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                            break;
                    }
                </a>
            }
        </div>
    }

    <button class="scroll-top" id="scrollTop" aria-label="Lên đầu trang">
        <svg class="ico ico-lg" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script src="~/js/3d-effects.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>