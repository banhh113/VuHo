<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CLB Võ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container nav-wrapper">
            <a class="logo" asp-controller="Home" asp-action="Index">🥋 CLB VÕ</a>

            <nav>
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a href="/#about">Giới thiệu</a>
                <a href="/#news">Tin tức</a>
                <a href="/#events">Sự kiện</a>
                <a href="/#members">Thành viên</a>
                <a href="/#gallery">Thư viện</a>
                <a href="/#contact">Liên hệ</a>
            </nav>

            <a class="admin-link" asp-controller="Admin" asp-action="Index">🔐 Admin</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer id="contact" class="footer">
        <div class="container">
            <h3>🥋 Câu lạc bộ Võ</h3>
            <p>Rèn luyện • Kỷ luật • Bản lĩnh</p>
            <p>© @DateTime.Now.Year CLB Võ. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 