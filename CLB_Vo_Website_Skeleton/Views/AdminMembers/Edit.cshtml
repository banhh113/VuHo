@model CLBVo.Models.Member
@{
    ViewData["Title"] = "Sửa thành viên";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>✏️ Sửa thành viên</h1>
        <p class="admin-subtitle">@Model.FullName</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post"
      enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="AvatarUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Họ tên *</label>
        <input asp-for="FullName" required maxlength="150" />
    </div>

    <div class="form-group">
        <label>Vai trò *</label>
        <input asp-for="Role" required maxlength="100" />
    </div>

    <div class="form-group">
        <label>Mô tả ngắn</label>
        <textarea asp-for="Description" rows="4"></textarea>
    </div>

    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
    {
        <div class="form-group">
            <label>Ảnh hiện tại</label>
            <img src="@Model.AvatarUrl" alt="@Model.FullName"
                 style="width:120px;height:120px;border-radius:50%;
                        object-fit:cover;border:3px solid #f5c518" />
        </div>
    }

    <div class="form-group">
        <label>Thay ảnh mới (để trống nếu giữ ảnh cũ)</label>
        <input type="file" name="imageFile" accept="image/*" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>