@model CLBVo.Models.Member
@{
    ViewData["Title"] = "Thêm thành viên";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>+ Thêm thành viên</h1>
        <p class="admin-subtitle">Thêm HLV hoặc võ sinh mới</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form" autocomplete="off">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Họ tên *</label>
        <input asp-for="FullName" required maxlength="150" placeholder="VD: Nguyễn Văn A" />
    </div>

    <div class="form-group">
        <label>Email (Dùng để tạo tài khoản đăng nhập)</label>
        <input type="email" name="email" placeholder="VD: hlv.a@gmail.com" />
        <small>Nếu nhập Email, hệ thống sẽ tự tạo tài khoản cho thành viên này. Bỏ trống nếu chỉ muốn hiển thị hình ảnh.</small>
    </div>

    <div class="form-group">
        <label>Nhóm *</label>
        <select asp-for="Category" required>
            <option value="">-- Chọn nhóm --</option>
            <option value="Boxing">🥊 Boxing</option>
            <option value="Kickboxing">🦵 Kickboxing</option>
            <option value="HLV">🎓 Huấn luyện viên</option>
            <option value="Trợ giảng">📋 Trợ giảng</option>
        </select>
        <small>HLV và Trợ giảng sẽ được cấp quyền quản lý cao hơn Võ sinh.</small>
    </div>

    <div class="form-group">
        <label>Vai trò *</label>
        <input asp-for="Role" required maxlength="100" placeholder="VD: Huấn luyện viên, Võ sinh..." />
    </div>

    <div class="form-group">
        <label>Mô tả ngắn</label>
        <textarea asp-for="Description" rows="4" placeholder="VD: HLV chính với 10 năm kinh nghiệm..."></textarea>
    </div>

    <div class="form-group">
        <label>Ảnh đại diện</label>
        <input type="file" name="imageFile" accept="image/*" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Lưu thành viên</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>