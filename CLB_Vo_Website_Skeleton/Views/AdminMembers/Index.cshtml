@model List<CLBVo.Models.Member>
@{
    ViewData["Title"] = "Quản lý thành viên";
    Layout = "_AdminLayout";
    var catFilter = ViewBag.CategoryFilter as string;
}

<div class="admin-page-header">
    <div>
        <h1>👥 Quản lý thành viên</h1>
        <p class="admin-subtitle">HLV và võ sinh của CLB Vũ Hổ</p>
    </div>
    <a asp-action="Create" class="btn">+ Thêm thành viên</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Filter tabs -->
<div class="filter-tabs">
    <a asp-action="Index" class="@(string.IsNullOrEmpty(catFilter) ? "active" : "")">
        Tất cả (@ViewBag.CountAll)
    </a>
    <a asp-action="Index" asp-route-category="Boxing" class="@(catFilter == "Boxing" ? "active" : "")">
        🥊 Boxing (@ViewBag.CountBoxing)
    </a>
    <a asp-action="Index" asp-route-category="Kickboxing" class="@(catFilter == "Kickboxing" ? "active" : "")">
        🦵 Kickboxing (@ViewBag.CountKickboxing)
    </a>
    <a asp-action="Index" asp-route-category="HLV" class="@(catFilter == "HLV" ? "active" : "")">
        🎓 HLV (@ViewBag.CountHLV)
    </a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th style="width:100px">Ảnh</th>
            <th>Họ tên</th>
            <th style="width:140px">Nhóm</th>
            <th style="width:180px">Vai trò</th>
            <th>Mô tả</th>
            <th style="width:180px">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="empty">
                    Chưa có thành viên nào trong nhóm này.
                </td>
            </tr>
        }
        @foreach (var m in Model)
        {
            var catIcon = m.Category switch
            {
                "Boxing" => "🥊",
                "Kickboxing" => "🦵",
                "HLV" => "🎓",
                _ => "📌"
            };
            var catColor = m.Category switch
            {
                "Boxing" => "#f5c518",
                "Kickboxing" => "#60a5fa",
                "HLV" => "#34d399",
                _ => "#888"
            };
            var catLabel = m.Category ?? "Chưa phân loại";

            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(m.AvatarUrl))
                    {
                        <img src="@m.AvatarUrl" alt="@m.FullName"
                             class="thumb" style="border-radius:50%" />
                    }
                    else
                    {
                        <div class="thumb-empty" style="border-radius:50%">—</div>
                    }
                </td>
                <td><strong>@m.FullName</strong></td>
                <td>
                    <span class="status-badge"
                          style="background:@(catColor)20;color:@catColor;border:1px solid @(catColor)60">
                        @catIcon @catLabel
                    </span>
                </td>
                <td>
                    <span style="color:#f5c518;font-weight:600;font-size:.85rem;letter-spacing:1px">
                        @m.Role
                    </span>
                </td>
                <td>
                    <small style="color:#a0a0a0;font-size:.85rem">
                        @{
                            var desc = m.Description ?? "";
                            @(desc.Length > 80 ? desc.Substring(0, 80) + "..." : desc)
                        }
                    </small>
                </td>
                <td class="actions">
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn-sm btn-edit">
                        <span class="icon">✏️</span>
                        <span>Sửa</span>
                    </a>
                    <form asp-action="Delete" asp-route-id="@m.Id" method="post"
                          onsubmit="return confirm('Xóa thành viên này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-sm btn-delete">
                            <span class="icon">🗑️</span>
                            <span>Xóa</span>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>