@model CLBVo.Models.ClubInfo
@{
    ViewData["Title"] = "Thông tin CLB";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>⚙️ Thông tin CLB</h1>
        <p class="admin-subtitle">Cập nhật thông tin liên hệ, giới thiệu của CLB Vũ Hổ</p>
    </div>
    <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-secondary">
        👁️ Xem trang chủ
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-controller="AdminClubInfo" asp-action="Index" method="post"
      enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tên CLB *</label>
        <input asp-for="Name" required maxlength="200"
               placeholder="VD: Câu lạc bộ Võ thuật Vũ Hổ" />
        <small>Tên đầy đủ hiển thị trên website.</small>
    </div>

    <div class="form-group">
        <label>Mô tả / Giới thiệu</label>
        <textarea asp-for="Description" rows="6"
                  placeholder="Giới thiệu về lịch sử, sứ mệnh, giá trị của CLB..."></textarea>
        <small>Đoạn văn ngắn giới thiệu về CLB (hiển thị ở trang chủ).</small>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="form-group">
            <label>Ảnh CLB hiện tại</label>
            <img src="@Model.ImageUrl" alt="Ảnh CLB"
                 style="max-width:400px;border-radius:10px;border:2px solid rgba(255,255,255,0.1)" />
        </div>
    }

    <div class="form-group">
        <label>@(string.IsNullOrEmpty(Model.ImageUrl) ? "Ảnh CLB" : "Thay ảnh mới (để trống nếu giữ ảnh cũ)")</label>
        <input type="file" name="imageFile" accept="image/*" />
        <small>Chấp nhận jpg, png, gif, webp. Tối đa 5MB. Ảnh hiển thị ở phần "Giới thiệu CLB" trên trang chủ.</small>
    </div>

    <div class="form-group">
    <label>Địa chỉ</label>
    <textarea asp-for="Address" rows="3"
              placeholder="VD: Cơ sở 1: 123 Nguyễn Văn Cừ, Quận 5, TP.HCM&#10;Cơ sở 2: 456 Lê Lợi, Quận 1, TP.HCM"></textarea>
    <small>Mỗi dòng 1 địa chỉ (nếu CLB có nhiều cơ sở).</small>
</div>

    <div class="form-group">
    <label>Số điện thoại</label>
    <textarea asp-for="Phone" rows="2"
              placeholder="VD: 0948 660 111 (Thầy Vinh)&#10;0971 373 536 (Thầy Huấn)"></textarea>
    <small>Mỗi dòng 1 số (nếu có nhiều người liên hệ).</small>
</div>

    <div class="form-group">
        <label>Email</label>
        <input asp-for="Email" type="email" maxlength="150"
               placeholder="VD: lienhe@vuhoclb.vn" />
    </div>


    <div class="form-actions">
        <button type="submit" class="btn">💾 Lưu thông tin</button>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>