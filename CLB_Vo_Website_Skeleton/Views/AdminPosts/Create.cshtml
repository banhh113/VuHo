@model CLBVo.Models.Post
@{
    ViewData["Title"] = "Thêm bài viết";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1>+ Thêm bài viết</h1>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tiêu đề *</label>
        <input asp-for="Title" required maxlength="255" />
    </div>

    <div class="form-group">
        <label>Nội dung *</label>
        <textarea asp-for="Content" rows="10" required></textarea>
    </div>

    <div class="form-group">
        <label>Ngày đăng</label>
        <input asp-for="CreatedAt" type="datetime-local"
               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
        <small>Để trống sẽ dùng ngày hiện tại.</small>
    </div>

    <div class="form-group">
        <label>Ảnh đại diện</label>
        <input type="file" name="imageFile" accept="image/*" />
        <small>Chấp nhận jpg, png, gif, webp. Tối đa 5MB.</small>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Lưu bài viết</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>