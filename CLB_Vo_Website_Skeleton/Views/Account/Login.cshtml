@model CLBVo.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - CLB Vũ Hổ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
</head>
<body class="login-body">
    <div class="login-wrapper">
        <div class="login-box">
            <img src="~/images/logo.png" alt="CLB Vũ Hổ" class="login-logo" />
            <h2>Đăng nhập Admin</h2>

            <form asp-action="Login" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" type="email" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Mật khẩu</label>
                    <input asp-for="Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="checkbox-label">
                        <input asp-for="RememberMe" type="checkbox" />
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Đăng nhập</button>
                <a href="/" class="login-back">← Về trang chủ</a>
            </form>
        </div>
    </div>
</body>
</html>