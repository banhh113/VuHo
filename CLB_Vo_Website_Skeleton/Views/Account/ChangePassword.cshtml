@model CLBVo.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đổi mật khẩu - CLB Vũ Hổ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="login-wrapper">
        <div class="login-box">
            <img src="~/images/logo.png" alt="CLB Vũ Hổ" class="login-logo" />
            <h2>Đổi mật khẩu</h2>

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label>Mật khẩu hiện tại</label>
                    <input asp-for="CurrentPassword" type="password" placeholder="••••••" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Mật khẩu mới</label>
                    <input asp-for="NewPassword" type="password" placeholder="Ít nhất 6 ký tự" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Đổi mật khẩu</button>
                <a asp-controller="Admin" asp-action="Index" class="login-back">← Về Dashboard</a>
            </form>
        </div>
    </div>
</body>
</html>