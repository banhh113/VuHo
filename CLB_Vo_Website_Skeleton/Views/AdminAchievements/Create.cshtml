@model CLBVo.Models.Achievement
@{
    ViewData["Title"] = "Thêm thành tích";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1><i data-lucide="plus-circle" style="color:var(--accent-red)"></i> Thêm thành tích</h1>
        <p class="admin-subtitle">Thêm huy chương, giải thưởng mới</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i data-lucide="arrow-left"></i> Quay lại</a>
</div>

<form asp-action="Create" method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tiêu đề *</label>
        <input asp-for="Title" required maxlength="255" placeholder="VD: Huy chương vàng giải Boxing & Kickboxing toàn quốc" />
        <small>Tên ngắn gọn của thành tích.</small>
    </div>

    <div class="form-group">
        <label>Cuộc thi *</label>
        <input asp-for="Competition" required maxlength="255" placeholder="VD: Giải vô địch Boxing & Kickboxing toàn quốc 2026" />
        <small>Tên đầy đủ của giải đấu / cuộc thi.</small>
    </div>

    <div class="form-group">
        <label>Huy chương *</label>
        <select asp-for="Medal" required>
            <option value="">-- Chọn loại huy chương --</option>
            <option value="Huy chương vàng">Huy chương vàng</option>
            <option value="Huy chương bạc">Huy chương bạc</option>
            <option value="Huy chương đồng">Huy chương đồng</option>
            <option value="Giải nhất">Giải nhất</option>
            <option value="Giải nhì">Giải nhì</option>
            <option value="Giải ba">Giải ba</option>
        </select>
        <small>Chọn loại huy chương / giải thưởng.</small>
    </div>

    <div class="form-group">
        <label>Năm *</label>
        <input asp-for="Year" type="number" required min="1950" max="2100" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Lưu thành tích</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>