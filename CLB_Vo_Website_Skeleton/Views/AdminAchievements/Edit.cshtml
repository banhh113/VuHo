@model CLBVo.Models.Achievement
@{
    ViewData["Title"] = "Sửa thành tích";
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>✏️ Sửa thành tích</h1>
        <p class="admin-subtitle">@Model.Title</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label>Tiêu đề *</label>
        <input asp-for="Title" required maxlength="255" />
    </div>

    <div class="form-group">
        <label>Cuộc thi *</label>
        <input asp-for="Competition" required maxlength="255" />
    </div>

    <div class="form-group">
        <label>Huy chương *</label>
        <input asp-for="Medal" required maxlength="50" />
    </div>

    <div class="form-group">
    <label>Huy chương *</label>
    <select asp-for="Medal" required>
        <option value="">-- Chọn loại huy chương --</option>
        <option value="🥇 Huy chương vàng">🥇 Huy chương vàng</option>
        <option value="🥈 Huy chương bạc">🥈 Huy chương bạc</option>
        <option value="🥉 Huy chương đồng">🥉 Huy chương đồng</option>
        <option value="🏆 Giải nhất">🏆 Giải nhất</option>
        <option value="🎖️ Giải nhì">🎖️ Giải nhì</option>
        <option value="🏅 Giải ba">🏅 Giải ba</option>
        
    </select>
</div>

    <div class="form-actions">
        <button type="submit" class="btn">💾 Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>