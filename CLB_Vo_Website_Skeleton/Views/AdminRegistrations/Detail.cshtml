@model CLBVo.Models.Registration
@using CLBVo.Models
@{
    ViewData["Title"] = "Chi tiết đăng ký";
    Layout = "_AdminLayout";

    // Tính countdown
    int? daysLeft = null;
    string trialClass = "trial-none";
    string trialText = "";
    string trialSubtext = "";

    if (Model.TrialDate.HasValue)
    {
        var today = DateTime.Today;
        var trialDate = Model.TrialDate.Value.Date;
        daysLeft = (trialDate - today).Days;

        if (daysLeft < 0)
        {
            trialClass = "trial-past";
            trialText = "Đã qua " + Math.Abs(daysLeft.Value) + " ngày";
            trialSubtext = "Ngày tập thử đã qua — kiểm tra kết quả";
        }
        else if (daysLeft == 0)
        {
            trialClass = "trial-today";
            trialText = "Hôm nay!";
            trialSubtext = "Khách sẽ đến tập thử hôm nay";
        }
        else if (daysLeft <= 2)
        {
            trialClass = "trial-urgent";
            trialText = "Còn " + daysLeft + " ngày";
            trialSubtext = "Sắp tới — cần xác nhận lại với khách";
        }
        else if (daysLeft <= 7)
        {
            trialClass = "trial-soon";
            trialText = "Còn " + daysLeft + " ngày";
            trialSubtext = "Trong tuần này";
        }
        else
        {
            trialClass = "trial-future";
            trialText = "Còn " + daysLeft + " ngày";
            trialSubtext = "Đã lên lịch";
        }
    }
}

<div class="admin-page-header">
    <div>
        <h1>👤 @Model.FullName</h1>
        <p class="admin-subtitle">Đăng ký lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") | Mã: <span style="color:var(--gold);font-weight:bold">@Model.RegistrationCode</span></p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error">@TempData["Error"]</div>
}

<!-- ==================== DUYỆT VÀO TẬP ==================== -->
@if (Model.Status != RegistrationStatus.Joined && Model.Status != RegistrationStatus.Cancelled)
{
    <div class="admin-panel" style="margin-bottom:20px; border-left:4px solid #10b981; background:rgba(16,185,129,0.05)">
        <div class="panel-header" style="border-bottom:none; margin-bottom:10px; padding-bottom:0">
            <h2 style="color:#10b981; display:flex; align-items:center; gap:8px">🎉 Duyệt vào tập chính thức</h2>
        </div>
        <p style="color:#ccc; font-size:0.9rem; margin-bottom:16px">
            Bấm nút bên dưới để hệ thống tự động tạo tài khoản Đăng nhập cho Võ sinh này (Dựa trên Email hoặc SĐT).
        </p>
        <form asp-action="ApproveMember" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Tạo tài khoản cho khách hàng này?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn" style="background:#10b981; border-color:#10b981; color:white">Tạo tài khoản Võ sinh</button>
        </form>
    </div>
}

<!-- ==================== TRIAL DATE BANNER ==================== -->
@if (Model.TrialDate.HasValue)
{
    <div class="trial-banner @trialClass">
        <div class="trial-banner-icon">
            <svg class="ico" viewBox="0 0 24 24" style="width:28px;height:28px">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
                <path d="m9 16 2 2 4-4"/>
            </svg>
        </div>
        <div class="trial-banner-info">
            <span class="trial-banner-label">Ngày tập thử dự kiến</span>
            <strong class="trial-banner-date">
                @Model.TrialDate.Value.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
            </strong>
            <span class="trial-banner-sub">@trialSubtext</span>
        </div>
        <div class="trial-banner-countdown">
            <strong>@trialText</strong>
        </div>
    </div>
}

<div class="admin-two-col">
    <!-- Thông tin khách -->
    <div class="admin-panel">
        <div class="panel-header">
            <h2>📋 Thông tin khách</h2>
        </div>
        <ul class="info-list">
            <li><strong>Họ tên:</strong> @Model.FullName</li>
            <li><strong>SĐT:</strong> <a href="tel:@Model.Phone" style="color:var(--gold)">@Model.Phone</a></li>
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <li><strong>Email:</strong> <a href="mailto:@Model.Email" style="color:var(--gold)">@Model.Email</a></li>
            }
            @if (Model.Age.HasValue)
            {
                <li><strong>Tuổi:</strong> @Model.Age</li>
            }
            @if (!string.IsNullOrEmpty(Model.PreferredTime))
            {
                <li><strong>Khung giờ mong muốn:</strong> @Model.PreferredTime</li>
            }
            @if (!string.IsNullOrEmpty(Model.Experience))
            {
                <li><strong>Kinh nghiệm:</strong> @Model.Experience</li>
            }
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <li><strong>Lời nhắn:</strong> @Model.Message</li>
            }
        </ul>
    </div>

    <!-- Cập nhật trạng thái -->
    <div class="admin-panel">
        <div class="panel-header">
            <h2>🔄 Cập nhật trạng thái</h2>
        </div>
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Trạng thái</label>
                <select name="status" required>
                    @foreach (RegistrationStatus st in Enum.GetValues(typeof(RegistrationStatus)))
                    {
                        var label = st switch
                        {
                            RegistrationStatus.New => "🆕 Mới đăng ký",
                            RegistrationStatus.Contacting => "📞 Đang liên hệ",
                            RegistrationStatus.Confirmed => "✅ Đã xác nhận tham gia",
                            RegistrationStatus.Joined => "🥋 Đã vào tập",
                            RegistrationStatus.Archived => "🗄️ Lưu trữ (đăng ký ảo / spam)",
                            RegistrationStatus.Cancelled => "❌ Đã hủy",
                            _ => st.ToString()
                        };
                        if (st == Model.Status)
                        {
                            <option value="@st" selected>@label</option>
                        }
                        else
                        {
                            <option value="@st">@label</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Ngày tập thử dự kiến</label>
                <input type="date" name="trialDate" id="trialDateInput" value="@(Model.TrialDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <button type="submit" class="btn">💾 Cập nhật</button>
        </form>
    </div>
</div>

<!-- Ghi chú & Lịch sử (giữ nguyên phần dưới của bạn) -->
<div class="admin-panel" style="margin-top:20px">
    <div class="panel-header">
        <h2>📝 Ghi chú nội bộ</h2>
    </div>
    <form asp-action="SaveNote" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <textarea name="adminNote" rows="5" placeholder="Ghi chú về khách...">@Model.AdminNote</textarea>
        </div>
        <button type="submit" class="btn">💾 Lưu ghi chú</button>
    </form>
</div>