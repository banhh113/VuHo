@model CLBVo.Models.Post
@{
    ViewData["Title"] = Model.Title;
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:820px">
        <a href="/#news" class="back-link">← Quay lại tin tức</a>

        <p class="section-eyebrow" style="margin-top:30px">TIN TỨC</p>
        <h1 class="section-title" style="font-size:clamp(1.8rem,4vw,2.6rem);margin-bottom:16px">
            @Model.Title
        </h1>

        <span class="detail-meta">
            <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            @Model.CreatedAt.ToString("dddd, dd/MM/yyyy HH:mm", new System.Globalization.CultureInfo("vi-VN"))
        </span>

        <div style="margin-bottom:30px"></div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title"
                 style="width:100%;border-radius:12px;margin-bottom:30px;border:1px solid var(--border)" />
        }

        <div class="post-content">@Model.Content</div>

        <hr style="border:none;border-top:1px solid var(--border);margin:50px 0 30px" />

        <a href="/#news" class="btn btn-outline-red">← Về trang chủ</a>
    </div>
</section>