@model CLBVo.Models.Post
@{
    ViewData["Title"] = Model.Title;
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:820px">
        <a href="/#news" class="back-link">← Quay lại tin tức</a>

        <p class="eyebrow" style="margin-top:30px">Tin tức</p>
        <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);line-height:1.2;margin-bottom:16px">
            @Model.Title
        </h1>

        <p style="color:#a0a0a0;font-size:.9rem;margin-bottom:30px">
            📅 @Model.CreatedAt.ToString("dddd, dd/MM/yyyy HH:mm",
                new System.Globalization.CultureInfo("vi-VN"))
        </p>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title"
                 style="width:100%;border-radius:12px;margin-bottom:30px;
                        border:2px solid rgba(255,255,255,0.08)" />
        }

        <div class="post-content">
            @Model.Content
        </div>

        <hr style="border-color:rgba(255,255,255,0.1);margin:50px 0 30px" />

        <a href="/#news" class="btn btn-outline">← Về trang chủ</a>
    </div>
</section>