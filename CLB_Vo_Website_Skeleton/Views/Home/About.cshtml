@model CLBVo.Models.ClubInfo
@using CLBVo.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

@{
    ViewData["Title"] = "Giới thiệu CLB";

    var locations = Db.ClubLocations
        .Where(l => l.IsActive)
        .OrderBy(l => l.SortOrder)
        .ThenBy(l => l.Id)
        .ToList();
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:900px">
        <a href="/" class="back-link">← Về trang chủ</a>

        <p class="section-eyebrow" style="margin-top:30px">
            <span class="eyebrow-slash">/</span> VỀ CHÚNG TÔI
        </p>
        <h1 class="section-title" style="font-size:clamp(2rem,4vw,3rem);margin-bottom:24px">
            Giới thiệu CLB Vũ Hổ
        </h1>

        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="CLB Vũ Hổ"
                 style="width:100%;border-radius:12px;margin-bottom:30px;border:1px solid var(--border)" />
        }

        <div class="about-content">
            @if (!string.IsNullOrEmpty(Model?.Description))
            {
                @Model.Description
            }
            else
            {
                <p>CLB Vũ Hổ là nơi hội tụ những người yêu thích võ thuật. Chúng tôi hướng đến việc rèn luyện thể chất, kỷ luật và bản lĩnh cho mọi học viên.</p>
            }
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:40px 0 30px" />

        @if (locations.Any())
        {
            <div class="about-contact-item">
                <span>📍</span>
                <div style="flex:1">
                    <small>Địa chỉ</small>
                    @foreach (var loc in locations)
                    {
                        <div style="margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--border)">
                            <strong style="color:var(--gold);display:block;margin-bottom:6px;font-size:1rem">@loc.Name</strong>
                            <div style="white-space:pre-line;color:#ddd;margin-bottom:10px;line-height:1.6">@loc.Address</div>
                            @if (!string.IsNullOrEmpty(loc.MapUrl))
                            {
                                <a href="@loc.MapUrl" target="_blank" rel="noopener" class="map-link">
                                    🗺️ Mở Google Maps chỉ đường →
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model?.Address))
        {
            <div class="about-contact-item">
                <span>📍</span>
                <div>
                    <small>Địa chỉ</small>
                    <strong style="white-space:pre-line">@Model.Address</strong>
                </div>
            </div>
        }

        <div class="about-contact-grid">
            @if (!string.IsNullOrEmpty(Model?.Phone))
            {
                <div class="about-contact-item">
                    <span>📞</span>
                    <div>
                        <small>Điện thoại</small>
                        <strong style="white-space:pre-line">@Model.Phone</strong>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model?.Email))
            {
                <div class="about-contact-item">
                    <span>✉️</span>
                    <div>
                        <small>Email</small>
                        <strong>@Model.Email</strong>
                    </div>
                </div>
            }
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:50px 0 30px" />

        <a href="/" class="btn btn-outline-red">← Về trang chủ</a>
    </div>
</section>