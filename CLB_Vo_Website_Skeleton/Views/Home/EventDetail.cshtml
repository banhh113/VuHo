@model CLBVo.Models.ClubEvent
@{
    ViewData["Title"] = Model.Title;
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:820px">
        <a href="/#events" class="back-link">← Quay lại sự kiện</a>

        <p class="section-eyebrow" style="margin-top:30px">SỰ KIỆN</p>
        <h1 class="section-title" style="font-size:clamp(1.8rem,4vw,2.6rem);margin-bottom:16px">
            @Model.Title
        </h1>

        <div class="event-detail-meta">
            <div class="meta-item">
                <span class="meta-icon">
                    <svg class="ico ico-sm" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                <div>
                    <small>Ngày diễn ra</small>
                    <strong>@Model.EventDate.ToString("dddd, dd/MM/yyyy HH:mm", new System.Globalization.CultureInfo("vi-VN"))</strong>
                </div>
            </div>
            <div class="meta-item">
                <span class="meta-icon">
                    <svg class="ico ico-sm" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <div>
                    <small>Địa điểm</small>
                    <strong>@Model.Location</strong>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title"
                 style="width:100%;border-radius:12px;margin:30px 0;border:1px solid var(--border)" />
        }

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="post-content">@Model.Description</div>
        }

        <hr style="border:none;border-top:1px solid var(--border);margin:50px 0 30px" />

        <a href="/#events" class="btn btn-outline-red">← Về trang chủ</a>
    </div>
</section>