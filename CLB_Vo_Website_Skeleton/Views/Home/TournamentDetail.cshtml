@model CLBVo.Models.Tournament
@{
    ViewData["Title"] = Model.Name;
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:900px">
        <a href="/thanh-tich" class="back-link">← Tất cả giải đấu</a>

        <div style="display:flex;align-items:center;gap:20px;margin:30px 0 20px;flex-wrap:wrap">
            <div class="tournament-year-badge">@Model.Year</div>
            <div>
                <p class="section-eyebrow">GIẢI ĐẤU</p>
                <h1 class="section-title" style="font-size:clamp(1.6rem,4vw,2.4rem);margin:0">
                    @Model.Name
                </h1>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Location))
        {
            <span class="tournament-meta-row">
                <svg class="ico" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                @Model.Location
            </span>
        }

        @if (Model.StartDate.HasValue)
        {
            <span class="tournament-meta-row">
                <svg class="ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                @Model.StartDate.Value.ToString("dd/MM/yyyy")
                @if (Model.EndDate.HasValue && Model.EndDate.Value.Date != Model.StartDate.Value.Date)
                {
                    <span> — @Model.EndDate.Value.ToString("dd/MM/yyyy")</span>
                }
            </span>
        }

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name"
                 style="width:100%;border-radius:12px;margin:24px 0;border:1px solid var(--border)" />
        }

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div style="color:#ddd;line-height:1.8;white-space:pre-line;margin:24px 0">
                @Model.Description
            </div>
        }

        <h2 class="sub-heading" style="margin:40px 0 20px">Thành tích của VĐV</h2>

        @if (Model.Results.Any())
        {
            <div class="results-table">
                @foreach (var r in Model.Results)
                {
                    var medalClass = r.Medal.Contains("vàng", StringComparison.OrdinalIgnoreCase) ||
                                     r.Medal.Contains("nhất", StringComparison.OrdinalIgnoreCase) ||
                                     r.Medal.Contains("🥇") ? "medal-gold"
                                  : r.Medal.Contains("bạc", StringComparison.OrdinalIgnoreCase) ||
                                    r.Medal.Contains("nhì", StringComparison.OrdinalIgnoreCase) ||
                                    r.Medal.Contains("🥈") ? "medal-silver"
                                  : r.Medal.Contains("đồng", StringComparison.OrdinalIgnoreCase) ||
                                    r.Medal.Contains("ba", StringComparison.OrdinalIgnoreCase) ||
                                    r.Medal.Contains("🥉") ? "medal-bronze"
                                  : "medal-other";

                    // ⭐ CHỈ LINK NẾU CÓ MemberId
                    var hasMember = r.MemberId.HasValue && r.MemberId.Value > 0;

                    if (hasMember)
                    {
                        <a href="/members/@r.MemberId" class="result-row result-row-link">
                            <div class="result-medal @medalClass">
                                <svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                            </div>
                            <div class="result-info">
                                <strong>
                                    @r.MemberName
                                    <svg class="ico result-arrow" viewBox="0 0 24 24">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </strong>
                                @if (!string.IsNullOrEmpty(r.Category))
                                {
                                    <div class="result-category">@r.Category</div>
                                }
                                @if (!string.IsNullOrEmpty(r.Note))
                                {
                                    <div class="result-note">@r.Note</div>
                                }
                            </div>
                            <div class="result-medal-label">@r.Medal</div>
                        </a>
                    }
                    else
                    {
                        <div class="result-row">
                            <div class="result-medal @medalClass">
                                <svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                            </div>
                            <div class="result-info">
                                <strong>@r.MemberName</strong>
                                @if (!string.IsNullOrEmpty(r.Category))
                                {
                                    <div class="result-category">@r.Category</div>
                                }
                                @if (!string.IsNullOrEmpty(r.Note))
                                {
                                    <div class="result-note">@r.Note</div>
                                }
                            </div>
                            <div class="result-medal-label">@r.Medal</div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <p style="color:var(--gray-mid);font-style:italic">Chưa có thành tích nào được ghi nhận.</p>
        }

        <hr style="border:none;border-top:1px solid var(--border);margin:50px 0 30px" />
        <a href="/thanh-tich" class="btn btn-outline-red">← Về danh sách</a>
    </div>
</section>