<!-- ==================== ACHIEVEMENTS ==================== -->
<section class="section achievement reveal">
    <div class="container">
        <div class="section-header">
            <p class="section-eyebrow">THÀNH TÍCH</p>
            <h2 class="section-title">Dấu ấn của CLB</h2>
        </div>

        <div class="stats">
            <div>
                <strong>
                    <svg class="ico medal-gold" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    @Model.GoldCount
                </strong>
                <span>Huy chương vàng</span>
            </div>
            <div>
                <strong>
                    <svg class="ico medal-silver" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    @Model.SilverCount
                </strong>
                <span>Huy chương bạc</span>
            </div>
            <div>
                <strong>
                    <svg class="ico medal-bronze" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    @Model.BronzeCount
                </strong>
                <span>Huy chương đồng</span>
            </div>
            <div>
                <strong>
                    <svg class="ico medal-gold" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    @Model.TournamentCount
                </strong>
                <span>Giải đấu tham gia</span>
            </div>
        </div>

        @if (Model.TopAchievements.Any())
        {
            <div class="top-achievements-wrap">
                <h3 class="sub-heading">Thành tích tiêu biểu</h3>
                <div class="top-achievements">
                    @foreach (var a in Model.TopAchievements)
                    {
                        var medalClass = a.Medal.Contains("vàng", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("nhất", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("🥇") ? "medal-gold"
                                       : a.Medal.Contains("bạc", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("nhì", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("🥈") ? "medal-silver"
                                       : a.Medal.Contains("đồng", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("ba", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("🥉") ? "medal-bronze"
                                       : "medal-other";

                        var tournamentName = a.Tournament?.Name ?? a.TournamentNameText ?? "Không rõ giải";
                        var year = a.Tournament?.Year;

                        <div class="top-achievement-card">
                            <div class="top-achievement-medal @medalClass">
                                <svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                            </div>
                            <div class="top-achievement-info">
                                <strong>@a.MemberName</strong>
                                <div class="top-achievement-event">@tournamentName @(year.HasValue ? $"({year})" : "")</div>
                                @if (!string.IsNullOrEmpty(a.Category))
                                {
                                    <div class="top-achievement-category">@a.Category</div>
                                }
                            </div>
                            <div class="top-achievement-medal-label">@a.Medal</div>
                        </div>
                    }
                </div>
                <div class="center-actions">
                    <a href="/thanh-tich" class="btn btn-outline-red">Xem tất cả thành tích →</a>
                </div>
            </div>
        }
    </div>
</section>

<!-- ==================== GALLERY (VMMAF STYLE) ==================== -->
<section id="gallery" class="section gallery-section reveal">
    <div class="container">

        <div class="gallery-hero">
            <div class="gallery-hero-left">
                <p class="section-eyebrow">HÌNH ẢNH</p>
                <h2 class="gallery-hero-title">THƯ VIỆN<br />CLB</h2>
                <p class="gallery-hero-desc">
                    Kho tư liệu hình ảnh các giải đấu, vận động viên,
                    huấn luyện viên, trọng tài và các sự kiện của CLB Vũ Hổ.
                </p>
            </div>

            <div class="gallery-hero-right">
                @if (Model.Gallery.Any())
                {
                    var featuredImg = Model.Gallery.First();
                    <a href="@featuredImg.ImageUrl"
                       class="glightbox gallery-hero-img"
                       data-gallery="clb-gallery"
                       data-title="@featuredImg.Title">
                        <img src="@featuredImg.ImageUrl" alt="@featuredImg.Title" />
                    </a>
                }
                else
                {
                    <div class="gallery-hero-img gallery-hero-empty">
                        <img src="~/images/logo.png" alt="CLB Vũ Hổ" />
                    </div>
                }
            </div>
        </div>

        @if (Model.Gallery.Any())
        {
            <div class="gallery-strip-header">
                <h3 class="gallery-strip-title">Tất cả hình ảnh</h3>

                <div class="gallery-nav">
                    <button type="button" class="gallery-nav-btn" id="galleryPrev" aria-label="Ảnh trước">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                    </button>
                    <button type="button" class="gallery-nav-btn" id="galleryNext" aria-label="Ảnh tiếp theo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="gallery-scroll" id="galleryScroll">
                @foreach (var img in Model.Gallery)
                {
                    <a href="@img.ImageUrl"
                       class="gallery-card glightbox"
                       data-gallery="clb-gallery"
                       data-title="@img.Title"
                       data-description="@img.Title">
                        <img src="@img.ImageUrl" alt="@img.Title" loading="lazy" />
                        <div class="gallery-card-overlay">
                            <h4 class="gallery-card-title">@img.Title</h4>
                        </div>
                        <span class="gallery-card-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="empty-note">Chưa có ảnh nào trong thư viện.</p>
        }

    </div>
</section>
<!-- ==================== CONTACT ==================== -->
<section id="contact" class="section contact-section reveal">
    <div class="container">

        <div class="section-header" style="text-align:center;max-width:680px;margin:0 auto 46px">
            <p class="section-eyebrow" style="justify-content:center">LIÊN HỆ</p>
            <h2 class="section-title">Liên hệ với chúng tôi</h2>
            <p style="color:var(--gray);font-size:1rem;line-height:1.7">
                Có câu hỏi hoặc muốn tìm hiểu thêm về CLB?
                Hãy liên hệ với chúng tôi qua các kênh bên dưới — chúng tôi luôn sẵn sàng lắng nghe.
            </p>
        </div>

        <div class="contact-cards">

            <!-- ĐỊA CHỈ -->
            @if (Model.ClubLocations.Any() || addressLines.Any())
            {
                <div class="contact-card">
                    <div class="contact-card-icon">
                        <svg class="ico" viewBox="0 0 24 24">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <h3 class="contact-card-title">Địa chỉ</h3>

                    @if (Model.ClubLocations.Any())
                    {
                        foreach (var loc in Model.ClubLocations)
                        {
                            <div class="contact-location">
                                <strong>@loc.Name</strong>
                                <span>@loc.Address</span>
                                @if (!string.IsNullOrEmpty(loc.MapUrl))
                                {
                                    <a href="@loc.MapUrl" target="_blank" rel="noopener" class="contact-map-link">
                                        <svg class="ico ico-xs" viewBox="0 0 24 24">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        Mở Google Maps
                                        <svg class="ico ico-xs" viewBox="0 0 24 24">
                                            <line x1="7" y1="17" x2="17" y2="7"/>
                                            <polyline points="7 7 17 7 17 17"/>
                                        </svg>
                                    </a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        foreach (var line in addressLines)
                        {
                            <div class="contact-line">@line</div>
                        }
                    }
                </div>
            }

            <!-- SỐ ĐIỆN THOẠI -->
            @if (phoneLines.Any())
            {
                <div class="contact-card">
                    <div class="contact-card-icon">
                        <svg class="ico" viewBox="0 0 24 24">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                    </div>
                    <h3 class="contact-card-title">Số điện thoại</h3>

                    @foreach (var phone in phoneLines)
                    {
                        var telHref = System.Text.RegularExpressions.Regex.Replace(phone.Split('(')[0], @"[^\d+]", "");
                        <a href="tel:@telHref" class="contact-phone-item">
                            <svg class="ico ico-xs" viewBox="0 0 24 24">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                            </svg>
                            @phone
                        </a>
                    }
                </div>
            }

            <!-- EMAIL -->
            @if (!string.IsNullOrEmpty(Model.ClubInfo?.Email))
            {
                <div class="contact-card">
                    <div class="contact-card-icon">
                        <svg class="ico" viewBox="0 0 24 24">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <h3 class="contact-card-title">Email</h3>
                    <a href="mailto:@Model.ClubInfo.Email" class="contact-email-item">
                        <svg class="ico ico-xs" viewBox="0 0 24 24">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        @Model.ClubInfo.Email
                    </a>
                </div>
            }

            <!-- GIỜ MỞ CỬA -->
            @if (!string.IsNullOrEmpty(Model.ClubInfo?.OpeningHours))
            {
                <div class="contact-card">
                    <div class="contact-card-icon">
                        <svg class="ico" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <h3 class="contact-card-title">Giờ mở cửa</h3>
                    <div class="contact-hours">
                        @foreach (var line in Model.ClubInfo.OpeningHours.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            if (!string.IsNullOrWhiteSpace(line))
                            {
                                <div class="contact-line">@line.Trim()</div>
                            }
                        }
                    </div>
                </div>
            }

        </div>

        <!-- CTA -->
        <div class="contact-cta">
            <p class="contact-cta-text">Sẵn sàng bắt đầu hành trình của bạn?</p>
            <a class="btn btn-primary" asp-controller="Registration" asp-action="Index">
                <svg class="ico ico-sm" viewBox="0 0 24 24">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
                Đăng ký tập thử ngay
            </a>
        </div>

    </div>
</section>