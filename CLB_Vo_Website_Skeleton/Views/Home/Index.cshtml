@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <div class="container hero-content">
        <p class="eyebrow">CÂU LẠC BỘ VÕ</p>
        <h1>RÈN LUYỆN<br />KỶ LUẬT<br />BẢN LĨNH</h1>
        <p>Chào mừng bạn đến với website chính thức của Câu lạc bộ Võ.</p>
        <a class="btn" href="#about">Tìm hiểu CLB</a>
    </div>
</section>

<!-- ... phần còn lại giữ nguyên ... -->

<section id="about" class="section">
    <div class="container two-col">
        <div>
            <p class="eyebrow">VỀ CHÚNG TÔI</p>
            <h2>🥋 Giới thiệu CLB</h2>
            <p>
                Đây là khu vực giới thiệu lịch sử, mục tiêu, giá trị và định hướng
                hoạt động của câu lạc bộ.
            </p>
            <a class="text-link" href="#">Xem thêm →</a>
        </div>
        <div class="placeholder-image">ẢNH CLB</div>
    </div>
</section>

<section id="news" class="section section-alt">
    <div class="container">
        <p class="eyebrow">CẬP NHẬT</p>
        <h2>Tin tức mới nhất</h2>
        <div class="cards">
            <article class="card">
                <div class="card-image">ẢNH</div>
                <div class="card-body">
                    <small>01/10/2026</small>
                    <h3>Tiêu đề bài viết mẫu</h3>
                    <p>Nội dung mô tả ngắn của bài viết.</p>
                    <a href="#">Đọc thêm →</a>
                </div>
            </article>
            <article class="card">
                <div class="card-image">ẢNH</div>
                <div class="card-body">
                    <small>01/10/2026</small>
                    <h3>Hoạt động CLB</h3>
                    <p>Khu vực hiển thị hoạt động mới nhất.</p>
                    <a href="#">Đọc thêm →</a>
                </div>
            </article>
            <article class="card">
                <div class="card-image">ẢNH</div>
                <div class="card-body">
                    <small>01/10/2026</small>
                    <h3>Thông báo</h3>
                    <p>Khu vực hiển thị thông báo của CLB.</p>
                    <a href="#">Đọc thêm →</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="events" class="section">
    <div class="container">
        <p class="eyebrow">HOẠT ĐỘNG</p>
        <h2>Sự kiện sắp tới</h2>
        <div class="event-list">
            <div class="event-item">
                <strong>15</strong>
                <div>
                    <h3>Giải đấu võ thuật</h3>
                    <p>Tháng 12/2026 • Địa điểm sẽ cập nhật</p>
                </div>
            </div>
            <div class="event-item">
                <strong>20</strong>
                <div>
                    <h3>Buổi tập giao lưu</h3>
                    <p>Tháng 12/2026 • Phòng tập CLB</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="members" class="section section-dark">
    <div class="container">
        <p class="eyebrow">ĐỘI NGŨ</p>
        <h2>HLV & Thành viên</h2>
        <div class="cards">
            <article class="member-card">
                <div class="avatar">ẢNH</div>
                <h3>Nguyễn Văn A</h3>
                <p>Huấn luyện viên</p>
            </article>
            <article class="member-card">
                <div class="avatar">ẢNH</div>
                <h3>Trần Văn B</h3>
                <p>Võ sinh</p>
            </article>
            <article class="member-card">
                <div class="avatar">ẢNH</div>
                <h3>Lê Văn C</h3>
                <p>Võ sinh</p>
            </article>
        </div>
    </div>
</section>

<section id="gallery" class="section">
    <div class="container">
        <p class="eyebrow">HÌNH ẢNH</p>
        <h2>Thư viện CLB</h2>
        <div class="gallery">
            <div>ẢNH 01</div>
            <div>ẢNH 02</div>
            <div>ẢNH 03</div>
            <div>ẢNH 04</div>
            <div>ẢNH 05</div>
            <div>ẢNH 06</div>
        </div>
    </div>
</section>

<section class="section achievement">
    <div class="container">
        <p class="eyebrow">THÀNH TÍCH</p>
        <h2>Dấu ấn của CLB</h2>
        <div class="stats">
            <div><strong>🥇 12</strong><span>Huy chương vàng</span></div>
            <div><strong>🥈 18</strong><span>Huy chương bạc</span></div>
            <div><strong>🥉 25</strong><span>Huy chương đồng</span></div>
            <div><strong>🏆 10+</strong><span>Giải đấu tham gia</span></div>
        </div>
    </div>
</section>
