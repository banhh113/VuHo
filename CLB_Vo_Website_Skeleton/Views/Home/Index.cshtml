@model CLBVo.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <div class="container hero-content">
        <div class="hero-text">
            <img src="~/images/logo.png" alt="CLB Vũ Hổ" class="hero-logo" />
            <p class="eyebrow">Câu lạc bộ võ thuật</p>
            <h1>
                <span class="small">CLB VŨ HỔ</span>
                RÈN LUYỆN<br />KỶ LUẬT &amp; BẢN LĨNH
            </h1>
            <div class="hero-tagline">
                <span>Boxing</span>
                <span>Kickboxing</span>
                <span>Võ cổ truyền</span>
                <span>Muay</span>
            </div>
            <p class="hero-desc">
                CLB Vũ Hổ — nơi hun đúc tinh thần võ thuật, rèn luyện thể chất và bản lĩnh cho thế hệ trẻ.
            </p>
            <div class="hero-actions">
                <a class="btn" href="/dang-ky">📩 Đăng ký tập thử</a>
                <a class="btn btn-outline" href="#about">Tìm hiểu CLB</a>
            </div>
        </div>
    </div>
</section>

<section id="about" class="section reveal">
    <div class="container two-col">
        <div>
            <p class="eyebrow">Về chúng tôi</p>
            <h2>🐯 Giới thiệu CLB</h2>
            <p style="color:#a0a0a0;margin-bottom:18px">
                @(string.IsNullOrEmpty(Model.ClubInfo?.Description)
                    ? "CLB Vũ Hổ là nơi hội tụ những người yêu thích võ thuật. Chúng tôi hướng đến việc rèn luyện thể chất, kỷ luật và bản lĩnh cho mọi học viên."
                    : Model.ClubInfo.Description)
            </p>
            <a class="text-link" asp-controller="Home" asp-action="About">Xem thêm →</a>
        </div>
        @if (!string.IsNullOrEmpty(Model.ClubInfo?.ImageUrl))
        {
            <img src="@Model.ClubInfo.ImageUrl" alt="CLB Vũ Hổ"
                 style="width:100%;border-radius:12px;border:2px solid rgba(255,255,255,0.08);
                        box-shadow:0 10px 40px rgba(0,0,0,0.5)" />
        }
        else
        {
            <div class="placeholder-image">ẢNH CLB</div>
        }
    </div>
</section>

<section id="news" class="section section-alt reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Cập nhật</p>
            <h2>Tin tức mới nhất</h2>
        </div>
        <div class="cards">
            @if (Model.Posts.Any())
            {
                @foreach (var post in Model.Posts)
                {
                    <article class="card">
                        <div class="card-image">
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <a href="@post.ImageUrl" class="glightbox" data-gallery="posts" data-title="@post.Title">
                                    <img src="@post.ImageUrl" alt="@post.Title" />
                                </a>
                            }
                            else
                            {
                                <span>ẢNH</span>
                            }
                        </div>
                        <div class="card-body">
                            <small>@post.CreatedAt.ToString("dd/MM/yyyy")</small>
                            <h3>@post.Title</h3>
                            <p>@post.Content</p>
                            <a asp-controller="Home" asp-action="PostDetail" asp-route-id="@post.Id">
                                Đọc thêm →
                            </a>
                        </div>
                    </article>
                }
            }
            else
            {
                <p style="color:#666;grid-column:1/-1;text-align:center">Chưa có bài viết nào.</p>
            }
        </div>
    </div>
</section>

<section id="events" class="section reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Hoạt động</p>
            <h2>Thông báo &amp; Lịch tập</h2>
        </div>
        <div class="event-list">
            @if (Model.Events.Any())
            {
                @foreach (var ev in Model.Events)
                {
                    <div class="event-item">
                        <strong>@ev.EventDate.Day</strong>
                        <div style="flex:1">
                            <h3>@ev.Title</h3>
                            <p>Tháng @ev.EventDate.Month/@ev.EventDate.Year • @ev.Location</p>
                        </div>
                        <a asp-controller="Home" asp-action="EventDetail" asp-route-id="@ev.Id"
                           class="event-more">Chi tiết →</a>
                    </div>
                }
            }
            else
            {
                <p style="color:#666;text-align:center">Chưa có sự kiện nào sắp diễn ra.</p>
            }
        </div>
    </div>
</section>

<!-- ==================== HLV (đầu tiên) ==================== -->
<section id="coaches" class="section section-dark reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Đội ngũ</p>
            <h2>🎓 Huấn luyện viên</h2>
        </div>
        <div class="cards">
            @if (Model.Coaches.Any())
            {
                @foreach (var m in Model.Coaches)
                {
                    <a asp-controller="Home" asp-action="MemberDetail" asp-route-id="@m.Id"
                       style="text-decoration:none;color:inherit">
                        <article class="member-card">
                            <div class="avatar">
                                @if (!string.IsNullOrEmpty(m.AvatarUrl))
                                {
                                    <img src="@m.AvatarUrl" alt="@m.FullName" />
                                }
                                else
                                {
                                    <span>ẢNH</span>
                                }
                            </div>
                            <h3>@m.FullName</h3>
                            <p>@m.Role</p>
                        </article>
                    </a>
                }
            }
            else
            {
                <p style="color:#666;grid-column:1/-1;text-align:center">Chưa có HLV nào.</p>
            }
        </div>
    </div>
</section>

<!-- ==================== BOXING (thứ hai) ==================== -->
<section id="boxing" class="section reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Bộ môn</p>
            <h2>🥊 Võ sinh Boxing</h2>
        </div>
        <div class="cards">
            @if (Model.BoxingMembers.Any())
            {
                @foreach (var m in Model.BoxingMembers)
                {
                    <a asp-controller="Home" asp-action="MemberDetail" asp-route-id="@m.Id"
                       style="text-decoration:none;color:inherit">
                        <article class="member-card">
                            <div class="avatar">
                                @if (!string.IsNullOrEmpty(m.AvatarUrl))
                                {
                                    <img src="@m.AvatarUrl" alt="@m.FullName" />
                                }
                                else
                                {
                                    <span>ẢNH</span>
                                }
                            </div>
                            <h3>@m.FullName</h3>
                            <p>@m.Role</p>
                        </article>
                    </a>
                }
            }
            else
            {
                <p style="color:#666;grid-column:1/-1;text-align:center">Chưa có võ sinh Boxing.</p>
            }
        </div>
    </div>
</section>

<!-- ==================== KICKBOXING (thứ ba) ==================== -->
<section id="kickboxing" class="section section-dark reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Bộ môn</p>
            <h2>🦵 Võ sinh Kickboxing</h2>
        </div>
        <div class="cards">
            @if (Model.KickboxingMembers.Any())
            {
                @foreach (var m in Model.KickboxingMembers)
                {
                    <a asp-controller="Home" asp-action="MemberDetail" asp-route-id="@m.Id"
                       style="text-decoration:none;color:inherit">
                        <article class="member-card">
                            <div class="avatar">
                                @if (!string.IsNullOrEmpty(m.AvatarUrl))
                                {
                                    <img src="@m.AvatarUrl" alt="@m.FullName" />
                                }
                                else
                                {
                                    <span>ẢNH</span>
                                }
                            </div>
                            <h3>@m.FullName</h3>
                            <p>@m.Role</p>
                        </article>
                    </a>
                }
            }
            else
            {
                <p style="color:#666;grid-column:1/-1;text-align:center">Chưa có võ sinh Kickboxing.</p>
            }
        </div>
    </div>
</section>

<!-- ==================== GALLERY ==================== -->
<section id="gallery" class="section reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Hình ảnh</p>
            <h2>Thư viện CLB</h2>
        </div>
        <div class="gallery">
            @if (Model.Gallery.Any())
            {
                @foreach (var img in Model.Gallery)
                {
                    <a href="@img.ImageUrl"
                       class="gallery-item glightbox"
                       data-gallery="clb-gallery"
                       data-title="@img.Title"
                       data-description="@img.Title">
                        <img src="@img.ImageUrl" alt="@img.Title" loading="lazy" />
                    </a>
                }
            }
            else
            {
                <p style="color:#666;grid-column:1/-1;text-align:center">
                    Chưa có ảnh nào trong thư viện.
                </p>
            }
        </div>
    </div>
</section>

<section class="section achievement reveal">
    <div class="container">
        <div class="section-header">
            <p class="eyebrow">Thành tích</p>
            <h2>Dấu ấn của CLB</h2>
        </div>
        <div class="stats">
            <div>
                <strong>🥇 @Model.GoldCount</strong>
                <span>Huy chương vàng</span>
            </div>
            <div>
                <strong>🥈 @Model.SilverCount</strong>
                <span>Huy chương bạc</span>
            </div>
            <div>
                <strong>🥉 @Model.BronzeCount</strong>
                <span>Huy chương đồng</span>
            </div>
            <div>
                <strong>🏆 @Model.TournamentCount</strong>
                <span>Giải đấu tham gia</span>
            </div>
        </div>

        @if (Model.TopAchievements.Any())
        {
            <div style="margin-top:50px">
                <h3 style="color:#fff;font-size:1.4rem;margin-bottom:20px">
                    🌟 Thành tích tiêu biểu
                </h3>
                <div class="top-achievements">
                    @foreach (var a in Model.TopAchievements)
                    {
                        var medalIcon = a.Medal.Contains("vàng", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("nhất", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("🥇") ? "🥇"
                                      : a.Medal.Contains("bạc", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("nhì", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("🥈") ? "🥈"
                                      : a.Medal.Contains("đồng", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("ba", StringComparison.OrdinalIgnoreCase) || a.Medal.Contains("🥉") ? "🥉" : "🏅";

                        var tournamentName = a.Tournament?.Name ?? a.TournamentNameText ?? "Không rõ giải";
                        var year = a.Tournament?.Year;

                        <div class="top-achievement-card">
                            <div class="top-achievement-medal">@medalIcon</div>
                            <div class="top-achievement-info">
                                <strong>@a.MemberName</strong>
                                <div class="top-achievement-event">@tournamentName @(year.HasValue ? $"({year})" : "")</div>
                                @if (!string.IsNullOrEmpty(a.Category))
                                {
                                    <div class="top-achievement-category">@a.Category</div>
                                }
                            </div>
                            <div class="top-achievement-medal-label">@a.Medal</div>
                        </div>
                    }
                </div>
                <div style="text-align:center;margin-top:24px">
                    <a href="/thanh-tich" class="btn btn-outline">Xem tất cả thành tích →</a>
                </div>
            </div>
        }
    </div>
</section>