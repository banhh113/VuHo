@model CLBVo.Models.Member
@{
    ViewData["Title"] = Model.FullName;
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:820px">
        <a href="/#coaches" class="back-link">← Quay lại thành viên</a>

        <div class="member-detail">
            <div class="member-detail-avatar">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.FullName" />
                }
                else
                {
                    <span>ẢNH</span>
                }
            </div>

            <div class="member-detail-info">
                <p class="section-eyebrow">THÀNH VIÊN</p>
                <h1 class="section-title" style="font-size:clamp(1.8rem,4vw,2.4rem);margin-bottom:10px">
                    @Model.FullName
                </h1>
                <p class="member-detail-role">@Model.Role</p>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="member-detail-desc">@Model.Description</p>
                }
            </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:50px 0 30px" />

        <a href="/#coaches" class="btn btn-outline-red">← Về trang chủ</a>
    </div>
</section>