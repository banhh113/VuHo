@model CLBVo.Models.Member
@{
    ViewData["Title"] = "TEST-OK-" + Model.FullName;

    var achievements = ViewBag.Achievements as List<CLBVo.Models.TournamentResult>
                       ?? new List<CLBVo.Models.TournamentResult>();

    // Đếm huy chương
    int goldCount = achievements.Count(a =>
        !string.IsNullOrEmpty(a.Medal) &&
        (a.Medal.Contains("vàng", StringComparison.OrdinalIgnoreCase) ||
         a.Medal.Contains("nhất", StringComparison.OrdinalIgnoreCase) ||
         a.Medal.Contains("🥇")));

    int silverCount = achievements.Count(a =>
        !string.IsNullOrEmpty(a.Medal) &&
        (a.Medal.Contains("bạc", StringComparison.OrdinalIgnoreCase) ||
         a.Medal.Contains("nhì", StringComparison.OrdinalIgnoreCase) ||
         a.Medal.Contains("🥈")));

    int bronzeCount = achievements.Count(a =>
        !string.IsNullOrEmpty(a.Medal) &&
        (a.Medal.Contains("đồng", StringComparison.OrdinalIgnoreCase) ||
         a.Medal.Contains("ba", StringComparison.OrdinalIgnoreCase) ||
         a.Medal.Contains("🥉")));
}

<section class="section" style="padding-top:140px">
    <div class="container" style="max-width:900px">
        <a href="/#coaches" class="back-link">← Quay lại thành viên</a>

        <div class="member-detail">
            <div class="member-detail-avatar">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.FullName" />
                }
                else
                {
                    <span>ẢNH</span>
                }
            </div>

            <div class="member-detail-info">
                <p class="section-eyebrow">THÀNH VIÊN</p>
                <h1 class="section-title" style="font-size:clamp(1.8rem,4vw,2.4rem);margin-bottom:10px">
                    @Model.FullName
                </h1>
                <p class="member-detail-role">@Model.Role</p>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="member-detail-desc">@Model.Description</p>
                }
            </div>
        </div>

        <!-- ==================== THÀNH TÍCH ==================== -->
        @if (achievements.Any())
        {
            <div class="member-achievements">
                <div class="member-achievements-header">
                    <h2 class="sub-heading" style="margin:0">
                        <svg class="ico" viewBox="0 0 24 24" style="width:22px;height:22px;color:var(--gold);vertical-align:-3px">
                            <circle cx="12" cy="8" r="6"/>
                            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                        </svg>
                        Thành tích (@achievements.Count)
                    </h2>

                    <!-- Tổng kết huy chương -->
                    <div class="member-medal-summary">
                        @if (goldCount > 0)
                        {
                            <span class="member-medal-badge medal-gold">
                                <svg class="ico ico-xs" viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="6"/>
                                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                                </svg>
                                @goldCount Vàng
                            </span>
                        }
                        @if (silverCount > 0)
                        {
                            <span class="member-medal-badge medal-silver">
                                <svg class="ico ico-xs" viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="6"/>
                                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                                </svg>
                                @silverCount Bạc
                            </span>
                        }
                        @if (bronzeCount > 0)
                        {
                            <span class="member-medal-badge medal-bronze">
                                <svg class="ico ico-xs" viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="6"/>
                                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                                </svg>
                                @bronzeCount Đồng
                            </span>
                        }
                    </div>
                </div>

                <div class="member-achievements-list">
                    @foreach (var a in achievements)
                    {
                        // Xác định loại huy chương
                        string medalClass = "medal-other";
                        string medalLabel = a.Medal;

                        if (!string.IsNullOrEmpty(a.Medal))
                        {
                            if (a.Medal.Contains("vàng", StringComparison.OrdinalIgnoreCase) ||
                                a.Medal.Contains("nhất", StringComparison.OrdinalIgnoreCase) ||
                                a.Medal.Contains("🥇"))
                            {
                                medalClass = "medal-gold";
                            }
                            else if (a.Medal.Contains("bạc", StringComparison.OrdinalIgnoreCase) ||
                                     a.Medal.Contains("nhì", StringComparison.OrdinalIgnoreCase) ||
                                     a.Medal.Contains("🥈"))
                            {
                                medalClass = "medal-silver";
                            }
                            else if (a.Medal.Contains("đồng", StringComparison.OrdinalIgnoreCase) ||
                                     a.Medal.Contains("ba", StringComparison.OrdinalIgnoreCase) ||
                                     a.Medal.Contains("🥉"))
                            {
                                medalClass = "medal-bronze";
                            }
                        }

                        // Tên giải đấu
                        var tournamentName = a.Tournament?.Name ?? a.TournamentNameText ?? "Không rõ giải";
                        var year = a.Tournament?.Year;
                        var location = a.Tournament?.Location;

                        <div class="member-achievement-item">
                            <div class="member-achievement-medal @medalClass">
                                <svg class="ico" viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="6"/>
                                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                                </svg>
                            </div>

                            <div class="member-achievement-info">
                                <h3 class="member-achievement-tournament">
                                    @tournamentName
                                    @if (year.HasValue)
                                    {
                                        <span class="member-achievement-year">(@year)</span>
                                    }
                                </h3>

                                <div class="member-achievement-meta">
                                    @if (!string.IsNullOrEmpty(location))
                                    {
                                        <span class="member-achievement-meta-item">
                                            <svg class="ico ico-xs" viewBox="0 0 24 24">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                                <circle cx="12" cy="10" r="3"/>
                                            </svg>
                                            @location
                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(a.Category))
                                    {
                                        <span class="member-achievement-meta-item">
                                            <svg class="ico ico-xs" viewBox="0 0 24 24">
                                                <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                                                <line x1="16" y1="8" x2="2" y2="22"/>
                                                <line x1="17.5" y1="15" x2="9" y2="15"/>
                                            </svg>
                                            @a.Category
                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(a.Note))
                                    {
                                        <span class="member-achievement-meta-item" style="font-style:italic;color:#777">
                                            @a.Note
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="member-achievement-medal-label @medalClass">
                                @medalLabel
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="member-achievements-empty">
                <svg class="ico" viewBox="0 0 24 24" style="width:38px;height:38px;color:var(--gray);opacity:.5">
                    <circle cx="12" cy="8" r="6"/>
                    <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                </svg>
                <p>Chưa có thành tích nào được ghi nhận.</p>
            </div>
        }

        <hr style="border:none;border-top:1px solid var(--border);margin:50px 0 30px" />

        <a href="/#coaches" class="btn btn-outline-red">← Về trang chủ</a>
    </div>
</section>