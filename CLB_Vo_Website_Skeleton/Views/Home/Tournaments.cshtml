@model CLBVo.ViewModels.TournamentsViewModel
@{
    ViewData["Title"] = "Thành tích";
}

<section class="section" style="padding-top:140px">
    <div class="container">
        <a href="/" class="back-link">← Về trang chủ</a>

        <div class="section-header" style="margin-top:30px">
            <p class="eyebrow">Thành tích</p>
            <h1 style="font-size:clamp(2rem,4vw,3rem)">Dấu ấn của CLB Vũ Hổ</h1>
        </div>

        <div class="stats" style="margin-bottom:50px">
            <div>
                <strong>🥇 @Model.GoldCount</strong>
                <span>Huy chương vàng</span>
            </div>
            <div>
                <strong>🥈 @Model.SilverCount</strong>
                <span>Huy chương bạc</span>
            </div>
            <div>
                <strong>🥉 @Model.BronzeCount</strong>
                <span>Huy chương đồng</span>
            </div>
            <div>
                <strong>🏆 @Model.Tournaments.Count</strong>
                <span>Giải đấu tham gia</span>
            </div>
        </div>

        @if (Model.Tournaments.Any())
        {
            <h2 style="margin-bottom:24px;color:#fff">Các giải đấu</h2>
            <div class="tournaments-list">
                @foreach (var t in Model.Tournaments)
                {
                    var gold = t.Results.Count(r =>
                        r.Medal.Contains("vàng", StringComparison.OrdinalIgnoreCase) ||
                        r.Medal.Contains("nhất", StringComparison.OrdinalIgnoreCase) ||
                        r.Medal.Contains("🥇"));
                    var silver = t.Results.Count(r =>
                        r.Medal.Contains("bạc", StringComparison.OrdinalIgnoreCase) ||
                        r.Medal.Contains("nhì", StringComparison.OrdinalIgnoreCase) ||
                        r.Medal.Contains("🥈"));
                    var bronze = t.Results.Count(r =>
                        r.Medal.Contains("đồng", StringComparison.OrdinalIgnoreCase) ||
                        r.Medal.Contains("ba", StringComparison.OrdinalIgnoreCase) ||
                        r.Medal.Contains("🥉"));

                    <a asp-action="TournamentDetail" asp-route-id="@t.Id" class="tournament-card">
                        @if (!string.IsNullOrEmpty(t.ImageUrl))
                        {
                            <img src="@t.ImageUrl" alt="@t.Name" class="tournament-card-img" />
                        }
                        <div class="tournament-card-body">
                            <div class="tournament-year">@t.Year</div>
                            <h3>@t.Name</h3>
                            @if (!string.IsNullOrEmpty(t.Location))
                            {
                                <p>📍 @t.Location</p>
                            }
                            <div class="tournament-medals">
                                @if (gold > 0) { <span class="medal-gold">🥇 @gold</span> }
                                @if (silver > 0) { <span class="medal-silver">🥈 @silver</span> }
                                @if (bronze > 0) { <span class="medal-bronze">🥉 @bronze</span> }
                                @if (gold + silver + bronze == 0)
                                {
                                    <span style="color:#666">Chưa có huy chương</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="admin-panel" style="text-align:center;padding:60px 20px">
                <p style="color:#666;font-style:italic">Chưa có giải đấu nào được ghi nhận.</p>
            </div>
        }
    </div>
</section>